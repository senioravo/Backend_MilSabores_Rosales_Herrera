# Configuración de Base de Datos Neon PostgreSQL
# Copia este archivo como .env y completa con tus credenciales reales

# Ejemplo de URL de Neon:
# jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech:5432/neondb?sslmode=require

DATABASE_URL=jdbc:postgresql://TU-HOST-NEON.aws.neon.tech:5432/neondb?sslmode=require
DATABASE_USERNAME=tu-usuario-neon
DATABASE_PASSWORD=tu-password-neon

# JWT Configuration: mínimo 32 caracteres (256 bits), si no el login falla.
# Generar uno con: openssl rand -hex 32
JWT_SECRET=milsabores-secret-key-2024-super-segura-para-produccion-cambiar
