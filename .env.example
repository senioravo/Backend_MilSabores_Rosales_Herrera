# Configuración de Base de Datos Neon PostgreSQL
# Copia este archivo como .env en ESTA misma carpeta (raíz del backend) y completa valores reales.
# Nunca subas .env a Git.

# --- Neon (obligatorio) ---
DATABASE_URL=jdbc:postgresql://TU-HOST-NEON.aws.neon.tech:5432/neondb?sslmode=require
DATABASE_USERNAME=tu-usuario-neon
DATABASE_PASSWORD=tu-password-neon

# --- JWT legacy (login email/password + fallback Entra) ---
# Mínimo 32 caracteres (256 bits), si no el login falla.
# Generar uno con: openssl rand -hex 32
JWT_SECRET=milsabores-secret-key-2024-super-segura-para-produccion-cambiar

# --- CORS del API Gateway (front local Vite) ---
FRONTEND_URL=http://localhost:5173

# --- Microsoft Entra ID (api-gateway + bff) ---
# Deben coincidir con .env.local del front (VITE_AZURE_*) y con la App Registration de la API en Azure.
# Para demo local MSAL + carrito: pon AZURE_ENTRA_ENABLED=true cuando tengas tenant/client/audience reales.
AZURE_ENTRA_ENABLED=false
AZURE_TENANT_ID=tu-tenant-id-aqui
AZURE_CLIENT_ID=tu-client-id-aqui
# Audience del access token (claim aud). Ejemplo: api://43cacae2-xxxx/access_as_user
AZURE_API_AUDIENCE=api://tu-client-id-aqui

# --- RabbitMQ local, clúster rabbit1 + rabbit2 ---
# La cookie es el secreto entre los nodos. Tiene que ser la misma en los dos.
# No es la clave con la que entras a la web.
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_ERLANG_COOKIE=milsabores-erlang-cookie
# Dentro de Docker Compose. En el PC, si el JAR corre fuera de Docker: localhost:5672,localhost:5673
# En la EC2 no hace falta cambiarla: docker-compose.ec2.yml usa rabbit1 y rabbit2
# por la red interna. La web del clúster queda en http://<IP-elástica>:15672 y :15673
RABBITMQ_ADDRESSES=rabbit1:5672,rabbit2:5672

# Kafka. Dentro de Docker Compose. En el PC, si el JAR corre fuera de Docker:
# localhost:19092,localhost:19093,localhost:19094
KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092,kafka3:9092
# kafka-admin usa esa misma variable. El BFF lo llama en el puerto 8087.
# KAFKA_ADMIN_SERVICE_URL=http://localhost:8087
#
# EC2. En el .env que se sube a la máquina de la aplicación, cambiar
# KAFKA_BOOTSTRAP_SERVERS por las IP privadas de las tres EC2 de Kafka.
# Esas IP no van en el código Java. En cada EC2 de Kafka, el mismo
# trío más KAFKA_NODE_ID (1, 2 o 3) y KAFKA_ADVERTISED_HOST (la IP de esa máquina).
# KAFKA_NODE_IP_1=10.0.1.11
# KAFKA_NODE_IP_2=10.0.1.12
# KAFKA_NODE_IP_3=10.0.1.13
# KAFKA_BOOTSTRAP_SERVERS=10.0.1.11:9092,10.0.1.12:9092,10.0.1.13:9092
# KAFKA_NODE_ID=1
# KAFKA_ADVERTISED_HOST=10.0.1.11

# URLs de microservicios (run-all-services.ps1 las fija a localhost; opcional override)
# USUARIO_SERVICE_URL=http://localhost:8081
# BFF_SERVICE_URL=http://localhost:8085
