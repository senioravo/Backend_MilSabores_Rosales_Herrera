# Configuración de Base de Datos Neon PostgreSQL
# Copia este archivo como .env en ESTA misma carpeta (raíz del backend) y completa valores reales.
# Nunca subas .env a Git.

# --- Neon (obligatorio) ---
DATABASE_URL=jdbc:postgresql://TU-HOST-NEON.aws.neon.tech:5432/neondb?sslmode=require
DATABASE_USERNAME=tu-usuario-neon
DATABASE_PASSWORD=tu-password-neon

# --- JWT legacy (login email/password + fallback Entra) ---
JWT_SECRET=milsabores-secret-key-2024-super-segura-para-produccion-cambiar

# --- CORS del API Gateway (front local Vite) ---
FRONTEND_URL=http://localhost:5173

# --- Microsoft Entra ID (api-gateway + bff) ---
# Deben coincidir con .env.local del front (VITE_AZURE_*) y con la App Registration de la API en Azure.
# Para demo local MSAL + carrito: pon AZURE_ENTRA_ENABLED=true cuando tengas tenant/client/audience reales.
AZURE_ENTRA_ENABLED=false
AZURE_TENANT_ID=tu-tenant-id-aqui
AZURE_CLIENT_ID=tu-client-id-aqui
# Audience del access token (claim aud). Ejemplo: api://43cacae2-xxxx/access_as_user
AZURE_API_AUDIENCE=api://tu-client-id-aqui

# URLs de microservicios (run-all-services.ps1 las fija a localhost; opcional override)
# USUARIO_SERVICE_URL=http://localhost:8081
# BFF_SERVICE_URL=http://localhost:8085
